{
  "pack_format": 1,
  "name": "@universal-harness-internal/pack-node",
  "version": "1.0.0",
  "stack": "node",
  "projection_views": ["prd", "plan"],
  "detection": {
    "markers": ["package.json"],
    "confidence": 0.9
  },
  "policies": [
    { "path": "loop.max_steps", "merge_operator": "hard_ceiling", "value": 30 },
    { "path": "loop.max_tokens", "merge_operator": "hard_ceiling", "value": 120000 },
    { "path": "loop.max_duration_ms", "merge_operator": "hard_ceiling", "value": 2700000 },
    { "path": "loop.max_tool_retries", "merge_operator": "hard_ceiling", "value": 2 },
    {
      "path": "loop.repeat_detection.window",
      "merge_operator": "project_default",
      "value": 6
    },
    {
      "path": "loop.repeat_detection.identical_action_limit",
      "merge_operator": "project_default",
      "value": 2
    },
    { "path": "controls.redaction", "merge_operator": "strongest_control", "value": "references" },
    { "path": "approvals.required", "merge_operator": "approval_union", "value": ["risk:high"] },
    {
      "path": "paths.deny",
      "merge_operator": "deny_union",
      "value": [".git", ".harness/locks", "node_modules"]
    }
  ],
  "gates": [
    {
      "gate_id": "gate_node_test",
      "layer": "stack",
      "name": "node test suite",
      "mandatory": true,
      "subject_id": "stack_node_test",
      "tool": "node_test"
    },
    {
      "gate_id": "gate_node_lint",
      "layer": "stack",
      "name": "node lint",
      "mandatory": false,
      "subject_id": "stack_node_lint",
      "tool": "node_lint"
    }
  ],
  "templates": {
    "provider_instruction": "# Harness Provider Instructions (Node Pack)\n\nYou are working in a Node.js repository governed by Universal Harness.\n\n- Stay inside the task envelope: read only the declared read paths, write only\n  the declared write paths and call only the granted tools.\n- Keep sources as ECMAScript modules with explicit import specifiers, matching\n  the project layout.\n- Run the project test script through the governed node_test tool; never\n  bypass it with ad hoc commands.\n- Keep package metadata and lockfiles consistent; do not add dependencies\n  without approval.\n- Report a structured result with a summary, the changed paths and evidence\n  references.\n"
  }
}
