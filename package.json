{
  "name": "universal-harness-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build && node scripts/check-workspace-exports.mjs",
    "dogfood:m4": "node scripts/dogfood-m4-local-scheduler.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:smoke": "pnpm build && node scripts/pack-cli.mjs && node scripts/pack-smoke.mjs",
    "test": "vitest run --config vitest.workspace.ts",
    "test:e2e": "vitest run --config vitest.workspace.ts tests/e2e",
    "test:e2e:dashboard": "playwright test --config playwright.dashboard.config.ts",
    "test:fault": "vitest run --config vitest.workspace.ts tests/fault",
    "test:performance": "vitest run --config vitest.performance.ts",
    "test:release": "pnpm test:security && pnpm test:fault && pnpm test:performance && pnpm test:e2e && pnpm test:e2e:dashboard && pnpm pack:smoke && node scripts/generate-acceptance-report.mjs",
    "test:security": "vitest run --config vitest.workspace.ts tests/security",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && node scripts/check-standalone.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "universal-harness": "workspace:*",
    "vitest": "4.1.10"
  }
}
