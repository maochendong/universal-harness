{
  "name": "event-stream-incremental-performance",
  "spec": "docs/superpowers/specs/2026-09-05-harness-transparency-sse-design.md#7.3",
  "environment": {
    "node": "v22.23.1",
    "platform": "darwin",
    "arch": "arm64"
  },
  "method": {
    "dataset_generator": "scripts/generate-performance-dataset.mjs --mode=event-stream",
    "seed": 1,
    "warmup_rounds": 20,
    "sample_rounds": 200,
    "rss": "process.memoryUsage().rss delta over the 100k-event index build, measured in-process after global.gc() when --expose-gc is available",
    "zero_reread": "fs.readFileSync/readSync spies count historical content bytes; JSON.parse spy excludes v2/legacy cursor decodes"
  },
  "scenarios": [
    {
      "name": "f-layout-discovery-poll",
      "layout": "f",
      "files": 1000,
      "events": 1000,
      "p50_ms": 8.94833299999982,
      "p95_ms": 10.311749999999847,
      "max_ms": 35.111667000000125,
      "threshold_ms": 200
    },
    {
      "name": "f-layout-discovery-poll",
      "layout": "f",
      "files": 10000,
      "events": 10000,
      "p50_ms": 102.96116599999732,
      "p95_ms": 176.88108300000022,
      "max_ms": 290.97979099999975,
      "threshold_ms": 200
    },
    {
      "name": "e-layout-index-rss",
      "layout": "e",
      "files": 100,
      "events": 100000,
      "rss_baseline_bytes": 365887488,
      "rss_after_bytes": 380600320,
      "rss_delta_bytes": 14712832,
      "rss_delta_mib": 14.03125,
      "gc_available": true,
      "threshold_mib": 256
    },
    {
      "name": "warm-poll-zero-history-reread",
      "layout": "f",
      "files": 1000,
      "events": 1000,
      "read_file_sync_calls": 0,
      "read_sync_calls": 0,
      "history_content_bytes": 0,
      "history_parse_count": 0
    },
    {
      "name": "shared-scan-4-caught-up-clients",
      "layout": "f",
      "files": 1000,
      "events": 1000,
      "ticks": 30,
      "source_refreshes_one_client": 30,
      "source_refreshes_four_clients": 30,
      "source_read_calls_one_client": 0,
      "source_read_calls_four_clients": 0,
      "source_read_bytes_one_client": 0,
      "source_read_bytes_four_clients": 0,
      "output_deliveries_one_client": 1000,
      "output_deliveries_four_clients": 4000,
      "note": "输出开销随客户端数线性增长，单独报告；共享源扫描与源读取工作量不随客户端数增长。"
    }
  ]
}
