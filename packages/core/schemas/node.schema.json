{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-harness.dev/m1/node.schema.json",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "Iteration" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "iteration_state": {} },
        "required": ["iteration_state"]
      },
      "else": {
        "not": {
          "properties": { "iteration_state": {} },
          "required": ["iteration_state"]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "Policy" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "policy_fields": {} },
        "required": ["policy_fields"]
      },
      "else": {
        "not": {
          "properties": { "policy_fields": {} },
          "required": ["policy_fields"]
        }
      }
    }
  ],
  "type": "object",
  "required": [
    "protocol_version",
    "record_kind",
    "id",
    "type",
    "revision",
    "status",
    "source",
    "provenance",
    "confidence",
    "digest"
  ],
  "properties": {
    "protocol_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "default": "1.0.0",
      "type": "string"
    },
    "record_kind": { "const": "node", "type": "string" },
    "id": {
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "type": {
      "anyOf": [
        { "const": "Project", "type": "string" },
        { "const": "Repository", "type": "string" },
        { "const": "Iteration", "type": "string" },
        { "const": "Intent", "type": "string" },
        { "const": "Requirement", "type": "string" },
        { "const": "Constraint", "type": "string" },
        { "const": "Decision", "type": "string" },
        { "const": "Component", "type": "string" },
        { "const": "ExecutionPlan", "type": "string" },
        { "const": "Task", "type": "string" },
        { "const": "CodeArtifact", "type": "string" },
        { "const": "Policy", "type": "string" },
        { "const": "ToolDefinition", "type": "string" },
        { "const": "Test", "type": "string" },
        { "const": "EvaluationCase", "type": "string" },
        { "const": "Gate", "type": "string" },
        { "const": "ContextBundle", "type": "string" },
        { "const": "Run", "type": "string" },
        { "const": "Checkpoint", "type": "string" },
        { "const": "Evidence", "type": "string" },
        { "const": "ApprovalRequest", "type": "string" },
        { "const": "Approval", "type": "string" },
        { "const": "Finding", "type": "string" },
        { "const": "RootCauseAnalysis", "type": "string" },
        { "const": "ImprovementCandidate", "type": "string" },
        { "const": "ImpactSet", "type": "string" }
      ]
    },
    "revision": { "minimum": 1, "type": "integer" },
    "status": {
      "anyOf": [
        { "const": "proposed", "type": "string" },
        { "const": "accepted", "type": "string" },
        { "const": "superseded", "type": "string" },
        { "const": "tombstoned", "type": "string" }
      ]
    },
    "source": {
      "anyOf": [
        { "const": "human", "type": "string" },
        { "const": "scanner", "type": "string" },
        { "const": "agent", "type": "string" },
        { "const": "workflow", "type": "string" },
        { "const": "tool", "type": "string" },
        { "const": "gate", "type": "string" },
        { "const": "evaluation", "type": "string" },
        { "const": "audit", "type": "string" },
        { "const": "migration", "type": "string" }
      ]
    },
    "provenance": {
      "additionalProperties": false,
      "type": "object",
      "required": ["iteration_id", "actor", "timestamp"],
      "properties": {
        "iteration_id": {
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "run_id": {
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "actor": { "minLength": 1, "maxLength": 200, "type": "string" },
        "timestamp": { "format": "date-time", "type": "string" }
      }
    },
    "confidence": { "minimum": 0, "maximum": 1, "type": "number" },
    "digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "locator": { "pattern": "^repo://[^/]+(?:/.*)?$", "type": "string" },
    "iteration_state": {
      "anyOf": [
        { "const": "draft", "type": "string" },
        { "const": "planned", "type": "string" },
        { "const": "running", "type": "string" },
        { "const": "verifying", "type": "string" },
        { "const": "blocked", "type": "string" },
        { "const": "completed", "type": "string" },
        { "const": "aborted", "type": "string" }
      ]
    },
    "policy_fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["path", "merge_operator", "value"],
        "properties": {
          "path": {
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$",
            "type": "string"
          },
          "merge_operator": {
            "anyOf": [
              { "const": "hard_ceiling", "type": "string" },
              { "const": "allow_intersection", "type": "string" },
              { "const": "deny_union", "type": "string" },
              { "const": "approval_union", "type": "string" },
              { "const": "strongest_control", "type": "string" },
              { "const": "project_default", "type": "string" }
            ]
          },
          "value": {}
        }
      }
    },
    "extensions": {
      "additionalProperties": false,
      "default": {},
      "type": "object",
      "patternProperties": { "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$": {} }
    }
  }
}
