{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-harness.dev/1.3/wave-integration.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "protocol_version",
    "record_kind",
    "wave_integration_id",
    "operation_id",
    "iteration_id",
    "plan_digest",
    "wave_index",
    "task_ids",
    "base_commit",
    "candidate_commit",
    "accepted_source_tree_digest",
    "task_lease_digests",
    "task_evidence_digests",
    "candidate_gate_evidence_digests",
    "wave_gate_evidence_digests",
    "policy_digest",
    "approval_digests",
    "command_id",
    "integrated_at",
    "record_digest"
  ],
  "properties": {
    "protocol_version": { "const": "1.3.0", "type": "string" },
    "record_kind": { "const": "wave_integration", "type": "string" },
    "wave_integration_id": {
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "operation_id": {
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "iteration_id": {
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "plan_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "wave_index": { "minimum": 0, "type": "integer" },
    "task_ids": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 3,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
        "type": "string"
      }
    },
    "base_commit": { "pattern": "^[0-9a-f]{7,40}$", "type": "string" },
    "candidate_commit": { "pattern": "^[0-9a-f]{7,40}$", "type": "string" },
    "accepted_source_tree_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "task_lease_digests": {
      "uniqueItems": true,
      "type": "array",
      "items": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
    },
    "task_evidence_digests": {
      "uniqueItems": true,
      "type": "array",
      "items": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
    },
    "candidate_gate_evidence_digests": {
      "uniqueItems": true,
      "type": "array",
      "items": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
    },
    "wave_gate_evidence_digests": {
      "uniqueItems": true,
      "type": "array",
      "items": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
    },
    "policy_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "approval_digests": {
      "uniqueItems": true,
      "type": "array",
      "items": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
    },
    "command_id": {
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9-]*_[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "integrated_at": { "format": "date-time", "type": "string" },
    "record_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
  }
}
