{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-harness.dev/1.1/project-discovery-output.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "purpose",
    "schema_version",
    "bundle_digest",
    "facts",
    "capability_candidates",
    "gate_candidates"
  ],
  "properties": {
    "purpose": { "const": "project_discovery", "type": "string" },
    "schema_version": { "const": "project-discovery.v1", "type": "string" },
    "bundle_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "facts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["fact", "confidence", "source_refs"],
        "properties": {
          "fact": { "minLength": 1, "type": "string" },
          "confidence": {
            "anyOf": [
              { "const": "low", "type": "string" },
              { "const": "medium", "type": "string" },
              { "const": "high", "type": "string" }
            ]
          },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    },
    "capability_candidates": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["capability_id", "rationale", "confidence", "source_refs"],
        "properties": {
          "capability_id": { "minLength": 1, "type": "string" },
          "rationale": { "minLength": 1, "type": "string" },
          "confidence": {
            "anyOf": [
              { "const": "low", "type": "string" },
              { "const": "medium", "type": "string" },
              { "const": "high", "type": "string" }
            ]
          },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    },
    "gate_candidates": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["gate_id", "rationale", "confidence", "source_refs"],
        "properties": {
          "gate_id": { "minLength": 1, "type": "string" },
          "rationale": { "minLength": 1, "type": "string" },
          "confidence": {
            "anyOf": [
              { "const": "low", "type": "string" },
              { "const": "medium", "type": "string" },
              { "const": "high", "type": "string" }
            ]
          },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
