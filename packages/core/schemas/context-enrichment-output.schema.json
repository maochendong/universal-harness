{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.universal-harness.dev/1.1/context-enrichment-output.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "purpose",
    "schema_version",
    "bundle_digest",
    "terms",
    "segment_summaries",
    "relevance_explanations"
  ],
  "properties": {
    "purpose": { "const": "context_enrichment", "type": "string" },
    "schema_version": { "const": "context-enrichment.v1", "type": "string" },
    "bundle_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" },
    "terms": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["term", "definition", "source_refs"],
        "properties": {
          "term": { "minLength": 1, "type": "string" },
          "definition": { "type": "string" },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    },
    "segment_summaries": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["locator", "summary", "source_refs"],
        "properties": {
          "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
          "summary": { "type": "string" },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    },
    "relevance_explanations": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": ["locator", "explanation", "source_refs"],
        "properties": {
          "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
          "explanation": { "minLength": 1, "type": "string" },
          "source_refs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["locator", "source_digest"],
              "properties": {
                "locator": { "minLength": 1, "maxLength": 400, "type": "string" },
                "source_digest": { "pattern": "^[a-f0-9]{64}$", "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
