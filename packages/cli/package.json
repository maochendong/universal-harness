{
  "name": "universal-harness",
  "version": "0.0.0",
  "description": "Graph-native, Git-native engineering harness: auditable new/adopt/iterate loops with governed agent execution.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maochendong/universal-harness.git"
  },
  "keywords": [
    "engineering-harness",
    "graph-ledger",
    "agent-governance",
    "audit"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "harness": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/cli/test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@universal-harness-internal/adapter-agent-dsh": "workspace:*",
    "@universal-harness-internal/adapter-agent-command": "workspace:*",
    "@universal-harness-internal/adapter-agent-manual": "workspace:*",
    "@universal-harness-internal/adapter-gate-llm-judge": "workspace:*",
    "@universal-harness-internal/adapter-projection-markdown": "workspace:*",
    "@universal-harness-internal/adapter-vcs-git": "workspace:*",
    "@universal-harness-internal/core": "workspace:*",
    "@universal-harness-internal/dashboard": "workspace:*",
    "@universal-harness-internal/eval": "workspace:*",
    "@universal-harness-internal/graph": "workspace:*",
    "@universal-harness-internal/plugin-sdk": "workspace:*",
    "@universal-harness-internal/runtime": "workspace:*"
  }
}
