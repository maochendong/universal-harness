exports[`harness CLI help and version > prints per-command help 1`] = `
"Usage: harness new <name> --intent <text> [--json]

Create a managed project directory, initialize the .harness control plane
(manifest, pack lock, ledger, managed .gitignore/.gitattributes) and run the
first full iteration for the given intent.
"
`;

exports[`harness CLI help and version > prints per-command help 2`] = `
"Usage: harness adopt [path] --intent <text> [--approve <staging-operation-id>] [--json]

Adopt an existing project: scan it into staging, approve the deterministic
baseline, then run the requested iteration. Nothing outside .harness is
modified, and the project root .gitignore is never touched. Non-interactive
sessions approve a staged preview with --approve.
"
`;

exports[`harness CLI help and version > prints per-command help 3`] = `
"Usage: harness iterate <text> [--json]

Run the full closed loop (capture, plan, execute, verify, evaluate, repair,
snapshot) for a follow-up change inside the current managed project.
"
`;

exports[`harness CLI help and version > prints per-command help 4`] = `
"Usage: harness resume <workflow-operation-id> [--json]

Resume a paused orchestration from its last committed checkpoint. The
workflow operation id is returned by earlier blocked or deferred runs.
"
`;

exports[`harness CLI help and version > prints per-command help 5`] = `
"Usage: harness abort <workflow-operation-id> [--actor <id>] [--json]

Abort an open workflow operation, closing its pending approval requests with
explicit reject decisions. This is the escape hatch when baseline drift seals
every recovery path; the abort is ledger-backed and keeps the audit history.
"
`;

exports[`harness CLI help and version > prints per-command help 6`] = `
"Usage: harness approve <request-id> --decision <approve|reject|defer> [--actor <id>] [--json]

Resolve exactly one pending approval request, bound to its recorded object
digest. Defer keeps the proposal resumable; reject closes it but keeps the
audit history.
"
`;

exports[`harness CLI help and version > prints per-command help 7`] = `
"Usage: harness impact [node-id] [--json]

Preview the ImpactSet a change on the given (or latest) seed node would
produce over the current artifact graph. Read-only.
"
`;

exports[`harness CLI help and version > prints per-command help 8`] = `
"Usage: harness plan [--json]

Show the latest committed declarative ExecutionPlan: mode, bound impact set
and task specifications.
"
`;

exports[`harness CLI help and version > prints per-command help 9`] = `
"Usage: harness run [--dry-run] [--json]

Execute the open workflow operation's planned tasks through the configured
adapter. --dry-run renders the planned tasks without executing anything.
"
`;

exports[`harness CLI help and version > prints per-command help 10`] = `
"Usage: harness verify [--json]

Drive the open workflow operation through the three-layer gate suite,
producing bound Evidence and Findings for failed mandatory gates.
"
`;

exports[`harness CLI help and version > prints per-command help 11`] = `
"Usage: harness eval [--json]

Drive the open workflow operation through run evaluation (outcome, safety,
trajectory, correct failure, efficiency).
"
`;

exports[`harness CLI help and version > prints per-command help 12`] = `
"Usage: harness snapshot [--json]

Drive the open workflow operation to its terminal snapshot, or report the
latest committed snapshot when no operation is open.
"
`;

exports[`harness CLI help and version > prints per-command help 13`] = `
"Usage: harness audit [--json]

Audit the committed graph for traceability gaps, stale knowledge,
contradictions, orphans, missing verification and unpromoted high-risk
improvements.
"
`;

exports[`harness CLI help and version > prints per-command help 14`] = `
"Usage: harness status [--json]

Show the managed project identity, committed ledger operation count, graph
cache health and the last ledger operation for the current project.
"
`;

exports[`harness CLI help and version > prints per-command help 15`] = `
"Usage: harness doctor [--json]

Diagnose the runtime environment, Git availability, managed project layout
and graph cache health. Exits non-zero when any check fails.
"
`;

exports[`harness CLI help and version > prints per-command help 16`] = `
"Usage: harness graph <sync|query|check> [options]

  sync    Rebuild the disposable SQLite cache from the authoritative ledger
  query   Query materialized graph nodes (--type, --limit, --cursor)
  check   Verify ledger integrity invariants and cache consistency
"
`;

exports[`harness CLI help and version > prints the CLI version 1`] = `
"universal-harness 0.0.0
"
`;

exports[`harness CLI inspection commands > fails graph query before the first sync 1`] = `
"{"category":"command_failed","data":{"cache_status":"missing"},"message":"graph cache is missing; run harness graph sync first","status":"error"}
"
`;

exports[`harness CLI inspection commands > rejects unknown graph subcommands and node types 1`] = `
"error [usage_error]: unknown graph subcommand: explode; expected sync, query or check
"
`;

exports[`harness CLI inspection commands > rejects unknown graph subcommands and node types 2`] = `
"error [usage_error]: unknown node type: Nonsense; expected one of Project, Repository, Iteration, Intent, Requirement, Constraint, Decision, Component, ExecutionPlan, Task, CodeArtifact, Policy, ToolDefinition, Test, EvaluationCase, Gate, ContextBundle, Run, Checkpoint, Evidence, ApprovalRequest, Approval, Finding, RootCauseAnalysis, ImprovementCandidate, ImpactSet
"
`;

