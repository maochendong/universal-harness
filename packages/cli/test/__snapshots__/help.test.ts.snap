exports[`harness CLI usage errors > rejects unknown options as usage errors 1`] = `
"error [usage_error]: Unknown option '--bogus'. To specify a positional argument starting with a '-', place it at the end of the command after '--', as in '-- "--bogus"; usage: harness status
"
`;

exports[`harness CLI usage errors > reports structured JSON usage errors in --json mode 1`] = `
"{"category":"usage_error","message":"harness new requires --intent <text>; usage: harness new <name> --intent <text>","status":"error"}
"
`;

exports[`harness CLI usage errors > requires --intent for new and adopt 1`] = `
"error [usage_error]: harness new requires --intent <text>; usage: harness new <name> --intent <text>
"
`;

